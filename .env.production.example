# .env.production.example — production template. EVERY blank value
# below MUST be filled before deploy. Boot will refuse to start otherwise.
#
# CRITICAL: LEMONSQUEEZY_TEST_MODE, CITATIONS_TEST_MODE, LIVE_AI_TEST_MODE
# all default to false. server.js will refuse to boot if any *_TEST_MODE
# is true while NODE_ENV=production.

APP_NAME=Quoted
APP_ENV=production
APP_URL=https://quotedeasy.com
API_URL=https://api.quotedeasy.com
FRONTEND_URL=https://quotedeasy.com
BACKEND_URL=https://api.quotedeasy.com

NODE_ENV=production
PORT=4000
DB_PATH=/data/cms.db
JWT_SECRET=                         # REQUIRED — openssl rand -hex 32, ≥32 chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

ADMIN_EMAIL=                        # REQUIRED — first admin user email
ADMIN_INITIAL_PASSWORD=             # REQUIRED — ≥12 chars, must NOT be ChangeMe123!
ADMIN_DISPLAY_NAME=Admin

TENANT_DEFAULT_DOMAIN=api.quotedeasy.com
TENANT_DEFAULT_SLUG=quoted
TENANT_DEFAULT_NAME=Quoted

# REQUIRED — comma-separated allow-list of public origins that may call /api/*
CORS_ORIGIN=https://quotedeasy.com,https://www.quotedeasy.com

UPLOAD_DIR=/data/uploads
UPLOAD_PUBLIC_URL=https://api.quotedeasy.com/uploads
UPLOAD_MAX_SIZE=3145728
MAX_UPLOAD_MB=3

TRUST_PROXY=true
TELEMETRY_ENABLED=true
LICENSE_ENFORCEMENT=strict          # production: refuse unsigned licenses
LICENSE_PUBLIC_KEY_PATH=keys/op-license-pub.pem
INDUSTRY=real-estate                # upstream OmniPlug skin; Quoted overlay ignores it

QUOTED_JWT_TTL_HOURS=24
QUOTED_FREE_POST_LIMIT=50
QUOTED_BOT_CRAWL_RETENTION_DAYS=90

FEATURE_PAYMENT=true
FEATURE_LICENSE=true
FEATURE_WEBHOOKS=true
FEATURE_LIVE_PAYMENT=true           # flip to true ONLY when LS is in live mode
FEATURE_CITATIONS=true
FEATURE_LIVE_AI_TEST=true

# ─── Lemon Squeezy LIVE ──────────────────────────────────────────────
PAYMENT_PROVIDER=lemonsqueezy
PAYMENT_MODE=live
LEMONSQUEEZY_TEST_MODE=false        # MUST be false in production
LEMONSQUEEZY_API_KEY=               # REQUIRED — LS live-mode API key
LEMONSQUEEZY_STORE_ID=              # REQUIRED — LS live store ID
LEMONSQUEEZY_WEBHOOK_SECRET=        # REQUIRED — LS webhook signing secret
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_AGENCY_MONTHLY=
LEMONSQUEEZY_VARIANT_AGENCY_YEARLY=
LEMONSQUEEZY_CHECKOUT_PRO_MONTHLY=
LEMONSQUEEZY_CHECKOUT_PRO_YEARLY=
LEMONSQUEEZY_CHECKOUT_AGENCY_MONTHLY=
LEMONSQUEEZY_CHECKOUT_AGENCY_YEARLY=

# ─── AI providers ────────────────────────────────────────────────────
CITATIONS_TEST_MODE=false
LIVE_AI_TEST_MODE=false
PERPLEXITY_API_KEY=                 # REQUIRED for citation sync + live AI test
TAVILY_API_KEY=                     # optional — extra citation source
SERPER_API_KEY=                     # optional — extra citation source
QUOTED_LIVE_AI_FREE_MONTHLY=3
QUOTED_LIVE_AI_PRO_MONTHLY=100
QUOTED_LIVE_AI_AGENCY_MONTHLY=250
