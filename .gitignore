# OS / editor noise
.DS_Store
Thumbs.db
*.log
*.swp
*~
.vscode/
.idea/
*.sublime-*

# Node (used by .pot extractor + zip builder)
node_modules/
package-lock.json
# Keep the vendored upstream lockfile so `npm ci` is reproducible.
!backend/omniplug/package-lock.json
!frontend/package-lock.json

# Local-only working copies (not part of the shipped plugin)
quoted-payments-v0.1.0/
.docker-local/
*.local

# Build / release artefacts
quoted-*.zip
quoted.zip
dist/
release/

# Backup / draft files
*.bak
*.orig

# Local backend runtime + secrets (never commit)
backend/omniplug/.env
backend/omniplug/data/
backend/omniplug/uploads/
backend/omniplug/backups/
backend/omniplug/keys/*.priv.pem
backend/omniplug/keys/*.qtd-license.txt
backend/omniplug/.qtd-inner.*.jwt
/data/
