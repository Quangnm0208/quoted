# .env.staging.example — staging template.
# Same shape as production but pointing at Lemon Squeezy TEST store +
# Perplexity API used live (modest quota). Webhook URL points at the
# deployed staging backend.

APP_NAME=Quoted
APP_ENV=staging
APP_URL=https://staging.quotedeasy.com
API_URL=https://api-staging.quotedeasy.com
FRONTEND_URL=https://staging.quotedeasy.com
BACKEND_URL=https://api-staging.quotedeasy.com

NODE_ENV=production
PORT=4000
DB_PATH=/data/cms.db
JWT_SECRET=                         # REQUIRED — openssl rand -hex 32
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@quotedeasy.com
ADMIN_INITIAL_PASSWORD=             # REQUIRED — ≥12 chars, ≠ ChangeMe123!
ADMIN_DISPLAY_NAME=Admin

TENANT_DEFAULT_DOMAIN=api-staging.quotedeasy.com
TENANT_DEFAULT_SLUG=quoted
TENANT_DEFAULT_NAME=Quoted

CORS_ORIGIN=https://staging.quotedeasy.com

UPLOAD_DIR=/data/uploads
UPLOAD_PUBLIC_URL=https://api-staging.quotedeasy.com/uploads
UPLOAD_MAX_SIZE=3145728
MAX_UPLOAD_MB=3

TRUST_PROXY=true
TELEMETRY_ENABLED=true
LICENSE_ENFORCEMENT=warn
LICENSE_PUBLIC_KEY_PATH=keys/op-license-pub.pem
INDUSTRY=real-estate

QUOTED_JWT_TTL_HOURS=24
QUOTED_FREE_POST_LIMIT=50
QUOTED_BOT_CRAWL_RETENTION_DAYS=90

FEATURE_PAYMENT=true
FEATURE_LICENSE=true
FEATURE_WEBHOOKS=true
FEATURE_LIVE_PAYMENT=false
FEATURE_CITATIONS=true
FEATURE_LIVE_AI_TEST=true

# ─── Lemon Squeezy STAGING — test store, real webhook ────────────────
PAYMENT_PROVIDER=lemonsqueezy
PAYMENT_MODE=sandbox
LEMONSQUEEZY_TEST_MODE=false
LEMONSQUEEZY_API_KEY=               # REQUIRED — LS test-mode API key
LEMONSQUEEZY_STORE_ID=              # REQUIRED — LS test store ID
LEMONSQUEEZY_WEBHOOK_SECRET=        # REQUIRED — LS webhook signing secret
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_AGENCY_MONTHLY=
LEMONSQUEEZY_VARIANT_AGENCY_YEARLY=
LEMONSQUEEZY_CHECKOUT_PRO_MONTHLY=
LEMONSQUEEZY_CHECKOUT_PRO_YEARLY=
LEMONSQUEEZY_CHECKOUT_AGENCY_MONTHLY=
LEMONSQUEEZY_CHECKOUT_AGENCY_YEARLY=

CITATIONS_TEST_MODE=false
LIVE_AI_TEST_MODE=false
PERPLEXITY_API_KEY=                 # REQUIRED for /citations/sync + /live-test/query
TAVILY_API_KEY=
SERPER_API_KEY=
QUOTED_LIVE_AI_FREE_MONTHLY=3
QUOTED_LIVE_AI_PRO_MONTHLY=100
QUOTED_LIVE_AI_AGENCY_MONTHLY=250
