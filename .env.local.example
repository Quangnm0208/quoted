# .env.local.example — copy to .env.local for LOCAL development.
# Run `npm run setup` to copy this + bootstrap deps + migrations.
#
# Local mode uses synthetic payment + AI provider responses so the full
# checkout → license → activation flow works without real API keys.
# DO NOT use these values in staging or production.

# ─── App identity ─────────────────────────────────────────────────────
APP_NAME=Quoted
APP_ENV=local
APP_URL=http://localhost:5500
API_URL=http://127.0.0.1:4000
FRONTEND_URL=http://localhost:5500
BACKEND_URL=http://127.0.0.1:4000

# ─── Backend ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DB_PATH=./data/cms.db
JWT_SECRET=dev-only-32-chars-or-more-quoted-local-key-12345
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# ─── First admin user (seeded if DB has no admin) ─────────────────────
ADMIN_EMAIL=admin@quoted.local
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=Admin

# ─── Tenant + CORS ────────────────────────────────────────────────────
TENANT_DEFAULT_DOMAIN=localhost
TENANT_DEFAULT_SLUG=demo
TENANT_DEFAULT_NAME=Demo Tenant
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:4000,http://127.0.0.1:5500,http://127.0.0.1:4000

# ─── Media uploads ────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=/uploads
UPLOAD_MAX_SIZE=3145728
MAX_UPLOAD_MB=3

# ─── Misc ─────────────────────────────────────────────────────────────
TRUST_PROXY=false
LEAD_RATE_LIMIT_PER_HOUR=20
TELEMETRY_ENABLED=false
LICENSE_ENFORCEMENT=warn
LICENSE_PUBLIC_KEY_PATH=keys/op-license-pub.pem

# ─── Industry skin (upstream OmniPlug — keep as 'real-estate' default,
#                    Quoted does not consume this) ───────────────────
INDUSTRY=real-estate

# ─── Quoted overlay knobs ─────────────────────────────────────────────
QUOTED_JWT_TTL_HOURS=24
QUOTED_FREE_POST_LIMIT=50
QUOTED_BOT_CRAWL_RETENTION_DAYS=90

# ─── Feature flags ────────────────────────────────────────────────────
FEATURE_PAYMENT=true
FEATURE_LICENSE=true
FEATURE_WEBHOOKS=true
FEATURE_LIVE_PAYMENT=false
FEATURE_CITATIONS=true
FEATURE_LIVE_AI_TEST=true

# ─── Lemon Squeezy — LOCAL = test mode (synthetic responses) ─────────
PAYMENT_PROVIDER=lemonsqueezy
PAYMENT_MODE=sandbox
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_API_KEY=test-key-fake-1234567890
LEMONSQUEEZY_STORE_ID=99999
LEMONSQUEEZY_WEBHOOK_SECRET=test-webhook-secret-for-local-only
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=100001
LEMONSQUEEZY_VARIANT_PRO_YEARLY=100002
LEMONSQUEEZY_VARIANT_AGENCY_MONTHLY=100003
LEMONSQUEEZY_VARIANT_AGENCY_YEARLY=100004
LEMONSQUEEZY_CHECKOUT_PRO_MONTHLY=https://example.lemonsqueezy.com/checkout/buy/test-pro-monthly
LEMONSQUEEZY_CHECKOUT_PRO_YEARLY=https://example.lemonsqueezy.com/checkout/buy/test-pro-yearly
LEMONSQUEEZY_CHECKOUT_AGENCY_MONTHLY=https://example.lemonsqueezy.com/checkout/buy/test-agency-monthly
LEMONSQUEEZY_CHECKOUT_AGENCY_YEARLY=https://example.lemonsqueezy.com/checkout/buy/test-agency-yearly

# ─── Citations + Live AI Test — LOCAL = test mode ───────────────────
CITATIONS_TEST_MODE=true
LIVE_AI_TEST_MODE=true
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
QUOTED_LIVE_AI_FREE_MONTHLY=3
QUOTED_LIVE_AI_PRO_MONTHLY=100
QUOTED_LIVE_AI_AGENCY_MONTHLY=250
