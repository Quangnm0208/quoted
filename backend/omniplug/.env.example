NODE_ENV=development
PORT=4000
DB_PATH=./data/cms.db

JWT_SECRET=dev-only-change-me-min-32-characters
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# REQUIRED in production. ADMIN_INITIAL_PASSWORD: min 12 chars, MUST NOT be 'ChangeMe123!'.
ADMIN_EMAIL=admin@omniplug.local
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=Admin

TENANT_DEFAULT_DOMAIN=localhost
TENANT_DEFAULT_SLUG=demo
TENANT_DEFAULT_NAME=Demo Tenant

# REQUIRED in production. Comma-separated list of allowed frontend origins.
# Example: CORS_ORIGIN=https://quotedeasy.com,https://www.quotedeasy.com
#
# Includes :5500 (Quoted marketing site dev port — `npm run fe`) so the
# CMS-driven hydration on index.html etc. is not blocked by the browser.
# Also includes 127.0.0.1 variants because the dev scripts bind there
# (Linux containers where `localhost` resolves to ::1 first).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:4000

UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=/uploads
# Max upload size in bytes. Default 3MB. Images > 25MP are rejected regardless of size.
UPLOAD_MAX_SIZE=3145728

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Audit log retention in days. Records older than this are pruned on startup (batch 1000/run).
AUDIT_LOG_RETENTION_DAYS=180

LEAD_RATE_LIMIT_PER_HOUR=20
TRUST_PROXY=false

FEATURE_ARTICLES=true
FEATURE_PROJECTS=true
FEATURE_LEADS=true
FEATURE_MEDIA=true
FEATURE_SDK=false
FEATURE_WEBHOOKS=false
FEATURE_API_KEYS=false
FEATURE_CRM=false

# License enforcement. Production should use strict with a real public key.
LICENSE_ENFORCEMENT=warn
LICENSE_PUBLIC_KEY_PATH=keys/op-license-pub.pem

# Telemetry - phone-home heartbeat to OmniPlug.
# Sends: instance UUID, version, tenant count, domain, node version, timestamp.
# Does NOT send: customer data, tenant slugs, user info, IPs, content.
# Set TELEMETRY_ENABLED=false to disable.
TELEMETRY_ENABLED=true
# OMNIPLUG_TELEMETRY_URL=https://telemetry.omniplug.com/v1/heartbeat

# ─────────────────────────────────────────────────────────────────────
# Quoted overlay — defaults are sane, override only if you know why.
#
# JWT TTL for the plugin-side bearer (issued at /api/v1/wp-sites/register).
QUOTED_JWT_TTL_HOURS=24
# Free-plan post quota — sites beyond this count return skipped_over_quota
# on /posts/sync instead of an error.
QUOTED_FREE_POST_LIMIT=50
# Retention for bot_crawls rows. cleanup runs nightly when the cron exists.
QUOTED_BOT_CRAWL_RETENTION_DAYS=90

# ─────────────────────────────────────────────────────────────────────
# Commercial layer (v0.4.0) — Lemon Squeezy integration.
#
# Get these from the LS dashboard:
#   API key:        https://app.lemonsqueezy.com/settings/api
#   Store ID:       store page → URL contains the numeric id
#   Webhook secret: store → webhooks → create webhook → reveal signing secret
#   Variant IDs:    product → variant → URL contains the numeric id
#   Checkout URLs:  variant → "Share" → copy hosted checkout URL
#
# Leave LEMONSQUEEZY_TEST_MODE=true in dev/CI — it short-circuits the
# License API roundtrip with a synthetic success response so tests can
# run without real LS credentials. PRODUCTION MUST NOT SET THIS.
#
# README contract: "The default .env ships in LEMONSQUEEZY_TEST_MODE=true
# so checkout → webhook → license activation → site registration all work
# end-to-end against a synthetic LS." Flip to false only when deploying
# with real Lemon Squeezy credentials.
LEMONSQUEEZY_TEST_MODE=true

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_AGENCY_MONTHLY=
LEMONSQUEEZY_VARIANT_AGENCY_YEARLY=

# Placeholder hosted-checkout URLs. In TEST_MODE the SDK/server only need
# these to be non-empty + look like URLs — the real LS roundtrip is mocked.
# In production replace each with the actual hosted URL from the LS variant
# share dialog (https://STORE.lemonsqueezy.com/buy/VARIANT_ID).
LEMONSQUEEZY_CHECKOUT_PRO_MONTHLY=https://example.lemonsqueezy.com/buy/test-pro-monthly
LEMONSQUEEZY_CHECKOUT_PRO_YEARLY=https://example.lemonsqueezy.com/buy/test-pro-yearly
LEMONSQUEEZY_CHECKOUT_AGENCY_MONTHLY=https://example.lemonsqueezy.com/buy/test-agency-monthly
LEMONSQUEEZY_CHECKOUT_AGENCY_YEARLY=https://example.lemonsqueezy.com/buy/test-agency-yearly

# Public-facing URLs used in webhooks + redirects.
APP_BASE_URL=http://localhost:5500
API_BASE_URL=http://localhost:4000
