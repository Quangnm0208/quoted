NODE_ENV=development
PORT=4000
DB_PATH=./data/cms.db

JWT_SECRET=dev-only-change-me-min-32-characters
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# REQUIRED in production. ADMIN_INITIAL_PASSWORD: min 12 chars, MUST NOT be 'ChangeMe123!'.
ADMIN_EMAIL=admin@omniplug.local
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=Admin

TENANT_DEFAULT_DOMAIN=localhost
TENANT_DEFAULT_SLUG=demo
TENANT_DEFAULT_NAME=Demo Tenant

# REQUIRED in production. Comma-separated list of allowed frontend origins.
# Example: CORS_ORIGIN=https://your-site.com,https://www.your-site.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4000

UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=/uploads
# Max upload size in bytes. Default 3MB. Images > 25MP are rejected regardless of size.
UPLOAD_MAX_SIZE=3145728

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Audit log retention in days. Records older than this are pruned on startup (batch 1000/run).
AUDIT_LOG_RETENTION_DAYS=180

LEAD_RATE_LIMIT_PER_HOUR=20
TRUST_PROXY=false

FEATURE_ARTICLES=true
FEATURE_PROJECTS=true
FEATURE_LEADS=true
FEATURE_MEDIA=true
FEATURE_SDK=false
FEATURE_WEBHOOKS=false
FEATURE_API_KEYS=false
FEATURE_CRM=false

# License enforcement. Production should use strict with a real public key.
LICENSE_ENFORCEMENT=warn
LICENSE_PUBLIC_KEY_PATH=keys/op-license-pub.pem

# Telemetry - phone-home heartbeat to OmniPlug.
# Sends: instance UUID, version, tenant count, domain, node version, timestamp.
# Does NOT send: customer data, tenant slugs, user info, IPs, content.
# Set TELEMETRY_ENABLED=false to disable.
TELEMETRY_ENABLED=true
# OMNIPLUG_TELEMETRY_URL=https://telemetry.omniplug.com/v1/heartbeat
