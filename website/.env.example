# Public site URL (used in canonical, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://quotedeasy.com

# Lemon Squeezy hosted checkout URLs.
# Get these from your Lemon Squeezy product variant -> Share tab.
# Leave blank during development -- pricing buttons will gracefully disable.
NEXT_PUBLIC_LEMONSQUEEZY_STARTER_MONTHLY_URL=
NEXT_PUBLIC_LEMONSQUEEZY_PRO_MONTHLY_URL=
NEXT_PUBLIC_LEMONSQUEEZY_STARTER_YEARLY_URL=
NEXT_PUBLIC_LEMONSQUEEZY_PRO_YEARLY_URL=

# Support / contact email shown on /support
NEXT_PUBLIC_SUPPORT_EMAIL=support@quotedeasy.com
